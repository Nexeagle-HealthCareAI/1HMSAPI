<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IssuePublicApiKey</RootNamespace>
    <!-- Ops-only tool, run manually against a connection string. Not referenced by
         EasyHMSAPI.Api and not part of the deployed Docker image. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\EasyHMSAPI.Domain\EasyHMSAPI.Domain.csproj" />
    <ProjectReference Include="..\..\EasyHMSAPI.Application\EasyHMSAPI.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
  </ItemGroup>
</Project>
