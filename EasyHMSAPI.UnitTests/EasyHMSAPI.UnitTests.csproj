<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="9.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <!-- Must be at least EasyHMSAPI.Api's own Microsoft.OpenApi version (1.6.25) now that
         this project references EasyHMSAPI.Api directly, or NuGet treats it as a package
         downgrade and fails restore. -->
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.25" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.11.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyHMSAPI.Application\EasyHMSAPI.Application.csproj" />
    <ProjectReference Include="..\EasyHMSAPI.Domain\EasyHMSAPI.Domain.csproj" />
    <!-- Needed to unit-test PermissionAuthorizationFilter (EasyHMSAPI.Api/Common) directly,
         same reasoning as testing any other Api/Common filter would require. -->
    <ProjectReference Include="..\EasyHMSAPI.Api\EasyHMSAPI.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="HandlerTests\QueryHandlerTests\" />
  </ItemGroup>
</Project>
