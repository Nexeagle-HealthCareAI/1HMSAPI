{
  "ApplicationInsights": {
    "ConnectionString": "<set-in-Azure-App-Service-ApplicationInsights-ConnectionString>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Security": {
    "OtpPepper": "<set-in-Azure-App-Service-Security-OtpPepper>"
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "<set-in-Azure-App-Service-ConnectionStrings-DefaultConnection>"
  },

  "Twilio": {
    "AccountSid": "<set-in-Azure-App-Service-Twilio-AccountSid>",
    "AuthToken": "<set-in-Azure-App-Service-Twilio-AuthToken>",
    "PhoneNumber": "<set-in-Azure-App-Service-Twilio-PhoneNumber>"
  },

  "Jwt": {
    "SecretKey": "<set-in-Azure-App-Service-Jwt-SecretKey>",
    "Issuer": "<set-in-Azure-App-Service-Jwt-Issuer>",
    "Audience": "<set-in-Azure-App-Service-Jwt-Audience>"
  },

  "Smtp": {
    "Server": "<set-in-Azure-App-Service-Smtp-Server>",
    "Port": 587,
    "SenderEmail": "<set-in-Azure-App-Service-Smtp-SenderEmail>",
    "AppPassword": "<set-in-Azure-App-Service-Smtp-AppPassword>"
  },

  "WhatsApp": {
    "IsEnabled": "<set-in-Azure-App-Service-WhatsApp-IsEnabled>",
    "ApiUrl": "<set-in-Azure-App-Service-WhatsApp-ApiUrl>",
    "AccessToken": "<set-in-Azure-App-Service-WhatsApp-AccessToken>"
  },

  "BlobStorage": {
    "StorageConnectionString": "<set-in-Azure-App-Service-BlobStorage-StorageConnectionString>",
    "AccountName": "<set-in-Azure-App-Service-BlobStorage-AccountName>",
    "AccountKey": "<set-in-Azure-App-Service-BlobStorage-AccountKey>",
    "ProfilePhotosContainer": "<set-in-Azure-App-Service-BlobStorage-ProfilePhotosContainer>",
    "PrescriptionsContainer": "<set-in-Azure-App-Service-BlobStorage-PrescriptionsContainer>",
    "PrescriptionTemplatesContainer": "<set-in-Azure-App-Service-BlobStorage-PrescriptionTemplatesContainer>",
    "PrescriptionAttachmentsContainer": "<set-in-Azure-App-Service-BlobStorage-PrescriptionAttachmentsContainer>",
    "InvoiceTemplatesContainer": "<set-in-Azure-App-Service-BlobStorage-InvoiceTemplatesContainer>"
  },

  "Invitation": {
    "RegistrationBaseUrl": "<set-in-Azure-App-Service-Invitation-RegistrationBaseUrl>"
  }
}