{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Security": {
    "OtpPepper": "<set-via-env-Security-OtpPepper>"
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "<set-via-env-ConnectionStrings-DefaultConnection>"
  },

  "Twilio": {
    "AccountSid": "<set-via-env-Twilio-AccountSid>",
    "AuthToken": "<set-via-env-Twilio-AuthToken>",
    "PhoneNumber": "<set-via-env-Twilio-PhoneNumber>"
  },

  "Jwt": {
    "SecretKey": "<set-via-env-Jwt-SecretKey>",
    "Issuer": "<set-via-env-Jwt-Issuer>",
    "Audience": "<set-via-env-Jwt-Audience>"
  },

  "Smtp": {
    "Server": "<set-via-env-Smtp-Server>",
    "Port": 587,
    "SenderEmail": "<set-via-env-Smtp-SenderEmail>",
    "AppPassword": "<set-via-env-Smtp-AppPassword>"
  },

  "WhatsApp": {
    "IsEnabled": "<set-via-env-WhatsApp-IsEnabled>",
    "ApiUrl": "<set-via-env-WhatsApp-ApiUrl>",
    "AccessToken": "<set-via-env-WhatsApp-AccessToken>",
    "CountryCode": "91"
  },

  "Abdm": {
    "ABDM_ClientId_Dev": "<set-via-env-Abdm-ABDM_ClientId_Dev>",
    "ABDM_ClientSecret_Dev": "<set-via-env-Abdm-ABDM_ClientSecret_Dev>",
    "GatewayBaseUrl": "https://dev.abdm.gov.in/api/hiecm/gateway",
    "AbhaBaseUrl": "https://abhasbx.abdm.gov.in/abha/api/v3",
    "CertUrl": "https://abhasbx.abdm.gov.in/abha/api/v3/profile/public/certificate"
  },

  "OpenAI": {
    "ApiKey": "<set-via-env-OpenAI-ApiKey>",
    "BaseUrl": "https://api.openai.com/v1",
    "WhisperModel": "whisper-1",
    "StructuringModel": "gpt-4o-mini"
  },

  "Deepgram": {
    "ApiKey": "<set-via-env-Deepgram-ApiKey>",
    "BaseUrl": "https://api.deepgram.com/v1",
    "Model": "nova-2-medical"
  },

  "BlobStorage": {
    "ProfilePhotosContainer": "profilepicture",
    "PrescriptionsContainer": "prescriptions",
    "PrescriptionTemplatesContainer": "prescriptiontemplates",
    "PrescriptionAttachmentsContainer": "prescriptionattachments",
    "HealthLockerContainer": "healthlocker",
    "PrescriptionDrawingsContainer": "prescriptiondrawings",
    "InvoiceTemplatesContainer": "invoicetemplates",
    "DischargeTemplatesContainer": "dischargetemplates",
    "DischargeSummaryContainer": "dischargesummary",
    "AdmissionDocumentsContainer": "admissiondocuments"
  },

  "Invitation": {
    "RegistrationBaseUrl": "<set-via-env-Invitation-RegistrationBaseUrl>"
  },

  "Storage": {
    "Provider": "S3",
    "S3": {
      "ServiceUrl": "",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "",
      "Prefix": "1HMS",
      "Region": "us-east-1",
      "ForcePathStyle": true,
      "UrlExpiryHours": 24
    }
  },

  "Cms": {
    "BaseUrl": "<set-via-env-Cms-BaseUrl>",
    "ServiceApiKey": "<set-via-env-Cms-ServiceApiKey>"
  },

  "WhatsAppBot": {
    "BaseUrl": "<set-via-env-WhatsAppBot-BaseUrl>",
    "InternalEventsToken": "<set-via-env-WhatsAppBot-InternalEventsToken>"
  },

  "Internal": {
    "ProxyForwardingSecret": "<set-via-env-Internal-ProxyForwardingSecret>"
  },

  "Groq": {
    "ApiKey": "<set-via-env-Groq-ApiKey>",
    "Model": "llama-3.3-70b-versatile"
  }
}