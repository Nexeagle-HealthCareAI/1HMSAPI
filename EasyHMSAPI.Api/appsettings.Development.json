{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Security": {
    "OtpPepper": "d7e4c9b1a5f8e3c2d6b9a4f1e7c3d8b5a9f2e6c1d4a7b8e9f3c6d9a2b5e8f1",
    "CredentialHashingEnabled": "true"
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=easyHMSDatabase;User ID=sa;Password=<your-local-sa-password>;TrustServerCertificate=True;Encrypt=False;Connection Timeout=60;"
  },

  "Twilio": {
    "AccountSid": "<set-via-appsettings.Development.local.json-or-user-secrets>",
    "AuthToken": "<set-via-appsettings.Development.local.json-or-user-secrets>",
    "PhoneNumber": "+16205420279"
  },

  "Jwt": {
    "SecretKey": "<set-via-appsettings.Development.local.json-or-user-secrets>",
    "Issuer": "NexEagle Dev",
    "Audience": "NexEagle EasyHMS Dev"
  },

  "Smtp": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "info@nexeagle.com",
    "AppPassword": "<set-via-appsettings.Development.local.json-or-user-secrets>"
  },

  "WhatsApp": {
    "IsEnabled": "true",
    "ApiUrl": "https://graph.facebook.com/v22.0/917702338094533/messages",
    "AccessToken": "<set-via-appsettings.Development.local.json-or-user-secrets>"
  },

  "BlobStorage": {
    "ProfilePhotosContainer": "profilepicture",
    "PrescriptionsContainer": "prescriptions",
    "PrescriptionTemplatesContainer": "prescriptiontemplates",
    "PrescriptionAttachmentsContainer": "prescriptionattachments",
    "InvoiceTemplatesContainer": "invoicetemplates",
    "DischargeTemplatesContainer": "dischargetemplates"
  },

  "Invitation": {
    "RegistrationBaseUrl": "http://localhost:3000/user-onboarding?token="
  },

  "Storage": {
    "Provider": "S3",
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "AccessKey": "<your-minio-access-key>",
      "SecretKey": "<your-minio-secret-key>",
      "Bucket": "nexeagle-dev",
      "Prefix": "1HMS",
      "Region": "us-east-1",
      "ForcePathStyle": true,
      "UrlExpiryHours": 24
    }
  }
}